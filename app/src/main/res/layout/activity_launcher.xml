<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android" 
    xmlns:app="http://schemas.android.com/apk/res-auto" 
    android:id="@+id/root" 
    android:layout_width="match_parent" 
    android:layout_height="match_parent">

    <LinearLayout 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:orientation="vertical" 
        android:padding="32dp" 
        app:layout_constraintTop_toTopOf="parent">
        <TextView 
            android:id="@+id/clockText" 
            android:layout_width="wrap_content" 
            android:layout_height="wrap_content" 
            android:text="21:42" 
            android:textSize="56sp" 
            android:fontFamily="sans-serif-light"/>
        <TextView 
            android:id="@+id/dateText" 
            android:layout_width="wrap_content" 
            android:layout_height="wrap_content" 
            android:text="Limi • Ultra Light" 
            android:textSize="13sp" 
            android:textColor="#8A8A8E"/>
    </LinearLayout>

    <TextView 
        android:id="@+id/swipeHint" 
        android:layout_width="wrap_content" 
        android:layout_height="wrap_content" 
        android:text="↓ Glisser ou toucher la barre" 
        android:paddingBottom="12dp"
        android:textSize="12sp"
        android:textColor="#999999"
        app:layout_constraintBottom_toTopOf="@id/toggleBar"
        app:layout_constraintStart_toStartOf="parent" 
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ✅ BARRE — PLUS ESPACÉE DU DOCK (32dp au lieu de 8dp) -->
    <TextView 
        android:id="@+id/toggleBar" 
        android:layout_width="60dp" 
        android:layout_height="6dp" 
        android:background="@drawable/bg_toggle_bar" 
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toTopOf="@id/dockContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout 
        android:id="@+id/dockContainer" 
        android:layout_width="0dp" 
        android:layout_height="wrap_content" 
        android:orientation="vertical" 
        android:layout_margin="12dp" 
        android:background="@drawable/bg_dock" 
        app:layout_constraintBottom_toBottomOf="parent" 
        app:layout_constraintStart_toStartOf="parent" 
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.recyclerview.widget.RecyclerView 
            android:id="@+id/dockRecycler" 
            android:layout_width="match_parent" 
            android:layout_height="84dp" 
            android:padding="8dp"/>
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout 
        android:id="@+id/drawerContainer" 
        android:layout_width="match_parent" 
        android:layout_height="match_parent" 
        android:visibility="gone" 
        android:background="@color/bg" 
        android:translationY="1000dp">
        <androidx.appcompat.widget.SearchView 
            android:id="@+id/searchView" 
            android:layout_width="0dp" 
            android:layout_height="wrap_content" 
            android:layout_margin="16dp" 
            android:background="@drawable/bg_search" 
            app:queryHint="@string/search_hint" 
            app:iconifiedByDefault="false" 
            app:layout_constraintTop_toTopOf="parent" 
            app:layout_constraintStart_toStartOf="parent" 
            app:layout_constraintEnd_toEndOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView 
            android:id="@+id/drawerRecycler" 
            android:layout_width="match_parent" 
            android:layout_height="0dp" 
            app:layout_constraintTop_toBottomOf="@id/searchView" 
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
